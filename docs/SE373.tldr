      },
      "parentId": "page:workspace-notify-20261017",
      "index": "a1V00025V",
      "typeName": "shape"
    },
    {
      "x": 0,
      "y": 880,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-028",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 740,
        "h": 280,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "blue",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NOTIFICATION BROKER [P2]",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Một blocker_id, nhiều adapter/delivery attempt"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "App inbox + 1 channel trước; mở rộng theo nhu cầu"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Preference / severity / privacy / quiet hours / quota"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fallback theo stage, không broadcast mọi kênh"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "sent ≠ delivered ≠ acknowledged ≠ resolved"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ack ở một kênh dừng ack-reminder; deadline vẫn giữ"
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00028V",
      "typeName": "shape"
    },
    {
      "x": 830,
      "y": 880,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-029",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 740,
        "h": 280,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "red",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "SECURITY / AUTHORITY",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Mỗi callback xác thực; link không cấp quyền"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Sensitive result trong app; tin nhắc chỉ nêu trạng thái"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Recheck audience và quyền trước từng delivery"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Nested tool và VM đều qua mandatory gateway"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Policy cấm chuyển dữ liệu → chờ/escalate"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Strict on-prem: không tự cloud fallback"
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00029V",
      "typeName": "shape"
    },
    {
      "x": 1660,
      "y": 880,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-030",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 740,
        "h": 280,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "violet",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "VM SPIKE [P3, CÓ ĐIỀU KIỆN]",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Core/request DB ngoài guest; guest chết có recovery"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Image version, CPU/RAM/disk/time cap, egress policy"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Tách workspace/volume theo scope; cleanup/retention"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Không shell/GUI toàn quyền để vượt tool contract"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Host chung chết không phải HA; backup + external alert"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Không bắt buộc desktop streaming hoặc computer-use"
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00030V",
      "typeName": "shape"
    },
    {
      "x": 0,
      "y": 1280,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-031",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 1140,
        "h": 270,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "DEMO CUỐI KỲ",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Giao việc → workspace chạy → đóng laptop vẫn tiến triển"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Gặp bước cần local file → chờ + báo đúng người"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Reconnect → reauthorize/reconcile → tiếp tục cùng request"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Restart worker/guest: không mất việc, không lặp action"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Kênh A lỗi → B; ack và resolved là hai trạng thái"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Đo business success, lifecycle coverage và recovery riêng"
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00031V",
      "typeName": "shape"
    },
    {
      "x": 1240,
      "y": 1280,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-032",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 1160,
        "h": 270,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "orange",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GIỚI HẠN SCOPE & CHI PHÍ",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "P1 giữ vertical slice; chưa hứa durable / VM"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "P2 durable wait + broker + server worker + reconnect"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "P3 một VM experiment; không làm platform hạ tầng"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Đo server CPU/RAM/traffic, tokens, local load, VM idle/startup/storage"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "So server-only baseline cùng quality; không mặc định offload rẻ hơn"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Hard failure phải có reason/evidence/owner/next action"
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00032V",
      "typeName": "shape"
    },
    {
      "x": 0,
      "y": 1660,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
        "proposal": "2026-10-17"
      },
      "id": "shape:workspace-notify-20261017-033",
      "type": "geo",
      "parentId": "page:workspace-notify-20261017",
      "props": {
        "w": 2400,
        "h": 200,
        "geo": "rectangle",
        "dash": "solid",
        "growY": 0,
        "url": "",
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "color": "grey",
        "labelColor": "black",
        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "ADAPTIVE / TEAM DECISIONS",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Instance nội bộ riêng mỗi company; config/schema/version + reviewed connectors. Agent auto-map chỉ tạo proposal có nguồn, mâu thuẫn và câu hỏi; không tự cấp quyền."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Chọn primary/fallback channel, deadline/quiet hours, một workload VM, host/resource cap, data-transfer policy và strict on-prem exceptions."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Auto-map / visual matching / browser model là optional; không thêm tất cả thành mandatory use case. Sửa issue → review → ADR sau khi nhóm chốt."
                }
              ]
            }
          ]
        }
      },
      "index": "a1V00033V",
      "typeName": "shape"
    },
