              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "COST LEDGER & BUDGET [P1 ước tính · P2 bền · P3 đối soát]",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ghi mọi attempt: model, tool, embedding, review skill, retry, lịch"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Append-only, ID khử trùng; số thập phân / đơn vị nhỏ nhất, không float"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Estimate / provider usage / invoice / shared allocation tách riêng; usage chưa biết ≠ 0"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Giữ chỗ budget nguyên tử trước khi gọi tốn tiền; budget agent ≠ duyệt chi tiền"
                }
              ]
            }
          ]
        }
