# Sao chép thành .env rồi điền. .env nằm trong .gitignore; đừng dán key vào code hay chat.
BIZOPS_PROFILE=haiku          # haiku | deepseek | gemma-uit | qwen-uit (xem agent/models.yaml)

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Endpoint LLM của trường: chỉ dùng được trong Wi-Fi trường
UIT_LLM_API_KEY=
# Máy đặt DNS công cộng thì host trường bị 302; điền IP nội bộ (dig @192.168.54.4 llm.uit.edu.vn)
UIT_RESOLVE_IP=
